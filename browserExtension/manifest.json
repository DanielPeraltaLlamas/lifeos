{
  "manifest_version": 3,
  "name": "Life OS · bloqueo",
  "version": "1.0.0",
  "description": "Bloquea webs de distracción durante los bloques de enfoque de Life OS.",
  "browser_specific_settings": {
    "gecko": {
      "id": "bloqueo@lifeos.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["webRequest", "webRequestBlocking", "tabs", "alarms"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1/*"],
  "background": { "scripts": ["rules.js", "background.js"] },
  "icons": { "48": "icon.svg", "96": "icon.svg" }
}
