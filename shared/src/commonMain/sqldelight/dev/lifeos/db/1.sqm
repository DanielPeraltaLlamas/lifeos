-- Versión 1 -> 2: calendario (Entrega 2).
CREATE TABLE event (
    id TEXT NOT NULL PRIMARY KEY,
    project_id TEXT,
    title TEXT NOT NULL,
    kind TEXT NOT NULL,
    date TEXT NOT NULL,
    start_min INTEGER NOT NULL,
    end_min INTEGER NOT NULL,
    repeat_weekly INTEGER NOT NULL DEFAULT 0,
    until_date TEXT,
    skip_dates TEXT NOT NULL DEFAULT '',
    location TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted_at INTEGER
);

CREATE INDEX event_date ON event(date);
