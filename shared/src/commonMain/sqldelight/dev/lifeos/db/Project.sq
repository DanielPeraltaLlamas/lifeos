-- kind: TFG | PERSONAL | SUBJECT
CREATE TABLE project (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    kind TEXT NOT NULL,
    description TEXT,
    due_date TEXT,
    sort_order INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted_at INTEGER
);

selectAll:
SELECT * FROM project WHERE deleted_at IS NULL ORDER BY sort_order, name COLLATE NOCASE;

selectById:
SELECT * FROM project WHERE id = ?;

insert:
INSERT INTO project(id, name, kind, description, due_date, sort_order, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE project SET name = ?, kind = ?, description = ?, due_date = ?, updated_at = ? WHERE id = ?;

softDelete:
UPDATE project SET deleted_at = :now, updated_at = :now WHERE id = :id;

count:
SELECT count(*) FROM project;
